{
  "manifest_version": 1,
  "id": "limits",
  "version": "0.0.1",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "entry": {
    "program": "tools/adapter"
  },
  "platforms": [
    {
      "os": "linux",
      "arch": "arm"
    },
    {
      "os": "android",
      "arch": "arm64"
    }
  ],
  "budgets": [
    {
      "frontend": "cli",
      "unit": "tokens",
      "limit": 1
    },
    {
      "frontend": "mcp",
      "unit": "chars",
      "limit": 131072
    },
    {
      "frontend": "direct",
      "unit": "tokens",
      "limit": 9000
    }
  ]
}
