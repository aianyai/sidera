{
  "manifest_version": 1,
  "id": "mapped",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "entry": {
    "program": "sidera-adapter-minimal"
  },
  "platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    }
  ],
  "config": {
    "preset": [
      {
        "key": "efforts_by_model",
        "type": "map",
        "title": "Efforts a requester may choose per model",
        "description": "Each entry names a model and lists the efforts allowed for it.",
        "value": {
          "type": "string_list"
        },
        "default": {
          "standard": [
            "low",
            "high"
          ]
        }
      },
      {
        "key": "limits",
        "type": "map",
        "title": "Limits",
        "value": {
          "type": "integer",
          "min": 0,
          "max": 100
        }
      }
    ]
  }
}
