{
  "kind": "request",
  "method": "initialize",
  "note": "a newer daemon declares a capability this version does not know; the reader ignores it",
  "ignoring": [
    "/params/capabilities/push_status",
    "/params/capabilities/limits"
  ],
  "document": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocol": {
        "min": 1,
        "max": 1
      },
      "daemon": {
        "version": "0.1.0"
      },
      "instance": {
        "id": "work",
        "lock_path": "/x/lock"
      },
      "capabilities": {
        "push_status": true,
        "limits": {
          "queue": 8
        }
      }
    }
  }
}
