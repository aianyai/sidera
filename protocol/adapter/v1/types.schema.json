{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidera.invalid/adapter/v1/types.schema.json",
  "title": "Sidera adapter protocol v1: shared types",
  "description": "Definitions shared by the method schemas. A rule marked 'Go only' cannot be stated in JSON Schema; the Go validators enforce it and the conformance tests list those cases.",
  "$defs": {
    "EndpointRef": {
      "description": "An endpoint of this node. Opaque: the daemon hands it out and the adapter hands it back unchanged.",
      "type": "string", "minLength": 1, "maxLength": 128
    },
    "Address": {
      "description": "A sender or recipient, '<node>/<endpoint>'. Opaque to the SDK; only the daemon checks the syntax.",
      "type": "string", "minLength": 1, "maxLength": 128
    },
    "MessageID": {
      "description": "Identifier of a message. Opaque.",
      "type": "string", "minLength": 1, "maxLength": 128
    },
    "AttemptID": {
      "description": "Number of a creation or prompt attempt: a lowercase UUID version 4.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "LeaseRef": {
      "description": "Identifier of one page handed out by a recv: 32 lowercase hexadecimal characters, not all zero.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": { "const": "00000000000000000000000000000000" }
    },
    "Token": {
      "description": "32 random bytes in unpadded base64url.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "NativeRef": {
      "description": "The adapter's own reference to a native session. Opaque to the daemon.",
      "type": "string", "minLength": 1, "maxLength": 256
    },
    "TurnRef": {
      "description": "The adapter's own reference to a turn. Opaque to the daemon.",
      "type": "string", "minLength": 1, "maxLength": 256
    },
    "TimestampMS": {
      "description": "Unix milliseconds, UTC. For display and diagnosis; the daemon judges time by its own clock.",
      "type": "integer", "minimum": 1, "maximum": 9007199254740991
    },
    "Detail": {
      "description": "Free text for people.",
      "type": "string", "minLength": 1, "maxLength": 1024
    },
    "Range": {
      "description": "A closed range of protocol versions. Go only: min is not greater than max.",
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "max": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "RequestID": {
      "description": "A request identifier: an integer or a string. An integer is written in plain digits, without a fraction or an exponent, which JSON Schema cannot require: 1.0 and 1e2 are integers to it, but not request identifiers.",
      "oneOf": [
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "string", "minLength": 1, "maxLength": 128 }
      ]
    },
    "AdapterID": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "PresetName": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "ModelName": {
      "description": "The name of a model as its runtime spells it: an alias, a full id, a cloud provider's id or an ARN. It holds no blank, control or non-ASCII character.",
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\[\\]-]*$"
    },
    "DisplayName": {
      "description": "A display name: 1 to 128 characters, none of them a control character, a line or paragraph separator, a bidirectional formatting control or a character that draws nothing (the zero width space, the word joiner, the byte order mark, a tag character, a Hangul filler and the like). A variation selector (U+FE00 to U+FE0F, U+E0100 to U+E01EF, U+180B to U+180D, U+180F) may follow any other character, one at a time, and is never first. At least one character is visible: a name of only spaces and invisible characters is refused. A name that breaks a rule is refused, not cleaned.",
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^(?:[ \u00a0\u00ad\u1680\u180e\u2000-\u200a\u200c\u200d\u202f\u205f\u2800\u3000][\u180b-\u180d\u180f\ufe00-\ufe0f\udb40\udd00-\udb40\uddef]?)*[^\u0000- \u007f-\u00a0\u00ad\u034f\u061c\u115f\u1160\u1680\u17b4\u17b5\u180b-\u180f\u2000-\u200f\u2028-\u202f\u205f-\u206f\u2800\u3000\u3164\ufe00-\ufe0f\ufeff\uffa0\ufff0-\ufff8\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc00-\udb43\udfff][\u180b-\u180d\u180f\ufe00-\ufe0f\udb40\udd00-\udb40\uddef]?(?:[^\u0000-\u001f\u007f-\u009f\u034f\u061c\u115f\u1160\u17b4\u17b5\u180b-\u180d\u180f\u200b\u200e\u200f\u2028-\u202e\u2060-\u206f\u3164\ufe00-\ufe0f\ufeff\uffa0\ufff0-\ufff8\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc00-\udb43\udfff][\u180b-\u180d\u180f\ufe00-\ufe0f\udb40\udd00-\udb40\uddef]?)*$"
    },
    "Description": {
      "description": "The description of an endpoint: 1 to 1024 characters. It may span lines and be indented, so a line feed and a tab are allowed; no other control character, no line or paragraph separator, no bidirectional formatting control and no character that draws nothing is, and a variation selector is never first or right after another, which is the rule of a display name apart from those two and from the visible character, which a description need not have. A description that breaks a rule is refused, not cleaned.",
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?:[^\u0000-\u0008\u000b-\u001f\u007f-\u009f\u034f\u061c\u115f\u1160\u17b4\u17b5\u180b-\u180d\u180f\u200b\u200e\u200f\u2028-\u202e\u2060-\u206f\u3164\ufe00-\ufe0f\ufeff\uffa0\ufff0-\ufff8\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc00-\udb43\udfff][\u180b-\u180d\u180f\ufe00-\ufe0f\udb40\udd00-\udb40\uddef]?)*$"
    },
    "SemVer": {
      "description": "A Semantic Versioning 2.0.0 version whose major, minor and patch have at most nine digits.",
      "type": "string", "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "ConfigKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "EnvName": {
      "type": "string", "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "ReasonWord": {
      "description": "A short snake_case word.",
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Env": {
      "description": "Environment variables to inject.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/EnvName" },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "ConfigValue": {
      "description": "A configuration value: a string, an integer, a boolean or a list of strings.",
      "oneOf": [
        { "type": "string", "maxLength": 4096 },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "boolean" },
        { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } }
      ]
    },
    "ConfigValues": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/ConfigKey" },
      "additionalProperties": { "$ref": "#/$defs/ConfigValue" }
    },
    "State": {
      "description": "Opaque adapter state stored by the daemon. Go only: at most 16384 bytes as compact JSON.",
      "type": "object"
    },

    "Frontend": { "type": "string", "enum": ["cli", "mcp"] },
    "ShutdownIntent": { "type": "string", "enum": ["restart", "stop", "retire"], "description": "Why the daemon ends the adapter: restart (a new process of the same instance follows at once), stop (the daemon is ending; the instance stays enabled) or retire (the instance is disabled or removed)." },
    "ContainerKind": { "type": "string", "enum": ["systemd_unit", "process_group", "launchd_job", "windows_job", "scheduled_task", "none"] },
    "AuthState": { "type": "string", "enum": ["valid", "invalid", "unknown"] },
    "DependencyState": { "type": "string", "enum": ["ok", "missing", "wrong_version"] },
    "ProbeOutcome": { "type": "string", "enum": ["ran", "not_run", "failed"] },
    "ProbeMethod": { "type": "string", "enum": ["sandboxed", "unsandboxed", "native_turn"] },
    "AvailabilityCondition": { "type": "string", "enum": ["runtime_auth", "native_unavailable", "dependency_missing"] },
    "AttachState": { "type": "string", "enum": ["attached", "unreachable", "lost"] },
    "SessionAttachOutcome": { "type": "string", "enum": ["attached", "not_found", "failed"] },
    "SessionAttachFailure": { "type": "string", "enum": ["wake_unavailable", "native_unreachable", "native_error"] },
    "CreateOutcome": { "type": "string", "enum": ["created", "failed", "indeterminate"] },
    "CreateFailure": { "type": "string", "enum": ["preset_unknown", "preset_invalid", "runtime_auth", "native_unavailable", "dependency_missing", "native_error", "control_unknown", "model_choice_not_allowed"] },
    "CheckpointScope": { "type": "string", "enum": ["attempt", "session"] },
    "PromptStage": { "type": "string", "enum": ["accepted", "persisted", "refused"] },
    "PromptRefusal": { "type": "string", "enum": ["busy", "runtime_auth", "native_unavailable", "session_lost", "control_unknown"] },
    "TurnFinal": { "type": "string", "enum": ["completed", "interrupted", "failed"] },
    "InterruptStage": { "type": "string", "enum": ["requested", "stopped", "not_running", "refused"] },
    "InterruptRefusal": { "type": "string", "enum": ["native_unreachable", "native_error"] },
    "CloseOutcome": { "type": "string", "enum": ["closed", "close_unconfirmed"] },
    "CloseReason": { "type": "string", "enum": ["turn_still_running", "native_unreachable"] },
    "ReconcileVerdict": { "type": "string", "enum": ["found", "provably_absent", "indeterminate"] },
    "TurnState": { "type": "string", "enum": ["running", "completed", "interrupted", "failed"] },
    "GroundsCode": {
      "type": "string",
      "enum": ["attempt_in_record", "record_complete_without_attempt", "never_dispatched", "turn_running", "record_unreadable", "native_unreachable"]
    },
    "AckVerdict": { "type": "string", "enum": ["allowed", "refused"] },
    "AckReason": { "type": "string", "enum": ["seen_in_full", "replaced", "truncated", "content_mismatch", "unknown_lease"] },
    "ItemAck": { "type": "string", "enum": ["recorded", "completed", "duplicate", "refused_no_handout", "refused_lease", "too_late"] },
    "Disposition": { "type": "string", "enum": ["preset", "rejected_by_preset", "rejected_unknown", "late"] },
    "DeliveryState": {
      "type": "string",
      "enum": ["queued", "accepted", "delivered", "rejected", "expired_unconfirmed", "delivery_unknown", "closed_unconfirmed"]
    },
    "RejectReason": {
      "type": "string",
      "enum": ["unauthorized", "endpoint_missing", "endpoint_closed", "endpoint_declined", "too_large", "expired", "backlog_expired", "second_check_failed", "malformed", "deadline_out_of_range", "backlog_full", "node_unsupported"]
    },
    "ControlSignal": { "type": "string", "enum": ["session.create", "session.close", "session.interrupt", "endpoint.status"] },
    "EndpointKind": { "type": "string", "enum": ["runtime", "session", "direct"] },
    "EndpointAction": {
      "description": "An action a directory entry says its endpoint accepts. Not ControlSignal: message.send, a plain message, is not a control signal.",
      "type": "string", "enum": ["message.send", "session.create", "session.close", "session.interrupt", "endpoint.status"]
    },
    "DirectoryOutcome": { "type": "string", "enum": ["ok", "unavailable", "refused"] },
    "PeerTrust": { "type": "string", "enum": ["self", "direct"] },
    "Effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"], "description": "The reasoning effort of a session, on a scale every runtime with the choice shares. A list of efforts is in the order of this table, lowest first." },
    "EffortList": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/Effort" }, "description": "Go only: the efforts are in the order of the scale." },
    "ModelAllowance": {
      "description": "A model a requester may choose and the efforts it may choose with it.",
      "type": "object",
      "required": ["model", "efforts"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/ModelName" },
        "efforts": { "$ref": "#/$defs/EffortList" }
      }
    },
    "AllowedModels": {
      "description": "A preset's allowlist: at most 16 models. Go only: the models are sorted by name with none twice.",
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "$ref": "#/$defs/ModelAllowance" }
    },
    "DirectoryCursor": {
      "description": "An opaque position in a directory listing, made by the node asked. It is good only for the endpoint and the daemon process it was made for, and grants nothing.",
      "type": "string", "minLength": 1, "maxLength": 256
    },
    "RuntimeInfo": {
      "description": "What a probe found out about the native runtime: its name and version, each 1 to 64 characters under the character rule of a display name, because both reach other nodes and their terminals in the directory.",
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/DisplayName", "maxLength": 64 },
        "version": { "$ref": "#/$defs/DisplayName", "maxLength": 64 }
      }
    },
    "DirectoryAdapter": {
      "description": "The adapter instance behind a directory entry. instance and id follow the syntax of an adapter identifier. version is omitted while the adapter has not connected since the node started, and runtime for an endpoint that is no runtime or session endpoint and while no probe has passed.",
      "type": "object",
      "required": ["instance", "id"],
      "additionalProperties": false,
      "properties": {
        "instance": { "$ref": "#/$defs/AdapterID" },
        "id": { "$ref": "#/$defs/AdapterID" },
        "version": { "$ref": "#/$defs/SemVer" },
        "runtime": { "$ref": "#/$defs/RuntimeInfo" }
      }
    },
    "DirectoryEntry": {
      "description": "One endpoint a node shows. display_name and description are omitted when the endpoint has none, and adapter when no adapter serves the endpoint or the node did not say.",
      "type": "object",
      "required": ["address", "kind", "accepts"],
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/Address" },
        "kind": { "$ref": "#/$defs/EndpointKind" },
        "display_name": { "$ref": "#/$defs/DisplayName" },
        "description": { "$ref": "#/$defs/Description" },
        "accepts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/EndpointAction" } },
        "adapter": { "$ref": "#/$defs/DirectoryAdapter" }
      }
    },
    "PeerProfile": {
      "description": "What a node says about itself. Every text is omitted when the node does not say it and is shown to a person, so each is under the character rule of a display name. platform is written <goos>/<goarch> by the node, which a reader does not rely on. as_of is when the daemon's node got the profile, in Unix seconds: for the node itself, when it issued it; for another node, when it fetched it.",
      "type": "object",
      "required": ["as_of"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/DisplayName" },
        "host_name": { "$ref": "#/$defs/DisplayName" },
        "platform": { "$ref": "#/$defs/DisplayName" },
        "system": { "$ref": "#/$defs/DisplayName" },
        "system_build": { "$ref": "#/$defs/DisplayName" },
        "sidera_version": { "$ref": "#/$defs/DisplayName" },
        "as_of": { "type": "integer", "minimum": 1, "maximum": 253402300799 }
      }
    },
    "PeerNode": {
      "description": "A node the daemon's node can address. self goes with trust self, and only with it. profile is omitted while the daemon has none for the node.",
      "type": "object",
      "required": ["node", "self", "trust", "connected"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "minLength": 1, "maxLength": 128 },
        "self": { "type": "boolean" },
        "trust": { "$ref": "#/$defs/PeerTrust" },
        "connected": { "type": "boolean" },
        "profile": { "$ref": "#/$defs/PeerProfile" }
      },
      "oneOf": [
        { "properties": { "self": { "const": true }, "trust": { "const": "self" } } },
        { "properties": { "self": { "const": false }, "trust": { "const": "direct" } } }
      ]
    },
    "Declaration": {
      "description": "What an endpoint declares about itself.",
      "type": "object",
      "required": ["paused", "refuse_multi_recipient", "restrict_senders", "accept_from", "hidden_from_directory"],
      "additionalProperties": false,
      "properties": {
        "paused": { "type": "boolean" },
        "refuse_multi_recipient": { "type": "boolean" },
        "restrict_senders": { "type": "boolean" },
        "accept_from": { "type": "array", "items": { "$ref": "#/$defs/Address" } },
        "hidden_from_directory": { "type": "boolean" }
      }
    },

    "Container": {
      "description": "What isolates a native process from the adapter. A process with kind none has no name; every other kind has one.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["systemd_unit", "process_group", "launchd_job", "windows_job", "scheduled_task"] },
            "name": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      ]
    },
    "ProcessIdentity": {
      "description": "One native process, in a form that survives PID reuse and restarts of the adapter and the daemon. The daemon stores and shows it and hands it back to a reconnecting adapter.",
      "type": "object",
      "required": ["pid", "start_key"],
      "additionalProperties": false,
      "properties": {
        "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "start_key": { "description": "Opaque; compared only for equality.", "type": "string", "minLength": 1, "maxLength": 64 },
        "started_at_ms": { "$ref": "#/$defs/TimestampMS" },
        "container": { "$ref": "#/$defs/Container" }
      }
    },
    "ToolAccess": {
      "description": "What a session needs to reach the channel's tools: environment variables the adapter injects.",
      "type": "object",
      "required": ["env"],
      "additionalProperties": false,
      "properties": { "env": { "$ref": "#/$defs/Env" } }
    },
    "WakeInfo": {
      "description": "What an adapter needs to deliver a prompt to a session a person runs. The names and values are the adapter's own; the daemon passes them through unchanged and keeps them in memory only. Never an empty object: leave the member out instead.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": { "$ref": "#/$defs/EnvName" },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "Capabilities": {
      "description": "What an adapter declares it supports. An absent runtime or direct part means the adapter provides no such endpoints. This object, runtime and direct are open: a member this version of the protocol does not define is ignored by the reader, so a newer adapter can declare a new capability to an older daemon, which then does not use it. Nothing else in the protocol is open. Members that are defined are checked as usual.",
      "type": "object",
      "properties": {
        "runtime": {
          "type": "object",
          "required": ["interrupt", "ack_on_behalf", "server_requests", "frontends"],
          "properties": {
            "interrupt": { "type": "boolean" },
            "ack_on_behalf": { "type": "boolean" },
            "server_requests": { "type": "boolean" },
            "frontends": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Frontend" } },
            "attach": { "type": "boolean", "description": "The adapter implements attached sessions: session.attach, the attached entries of adapter.start, session.detached, and their prompt and turn semantics. Optional; absent means false." },
            "model_choice": {
              "description": "The adapter takes a model and an effort in session.create, checks them against the preset's allowlist, answers model_choice_not_allowed when they are not allowed, keeps the choice with the session and reports each preset's defaults and allowlist when probed. Optional; absent means the adapter is never sent a choice. Go only: the efforts are in the order of the scale.",
              "type": "object",
              "required": ["efforts"],
              "additionalProperties": false,
              "properties": { "efforts": { "$ref": "#/$defs/EffortList" } }
            }
          }
        },
        "direct": {
          "type": "object",
          "required": ["max_endpoints"],
          "properties": {
            "max_endpoints": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "feedback": { "type": "boolean", "description": "The adapter decodes the member feedback of a message on a page. The daemon leaves the member out of the pages it sends to an adapter that did not declare this. Optional; absent means false." }
          }
        },
        "shutdown_intent": { "type": "boolean", "description": "The adapter understands the intent member of shutdown. Optional; absent means false." }
      }
    },
    "DaemonCapabilities": {
      "description": "What the daemon supports beyond the bare version, declared in initialize so that an adapter knows which additions it may use. Open like Capabilities: a reader ignores members it does not know, and an adapter must not use an addition the daemon did not declare. The object is always sent, empty when the daemon declares nothing. Members that are defined are checked as usual.",
      "type": "object",
      "properties": {
        "direct_endpoint_access": { "type": "boolean", "description": "The daemon serves endpoint.directory, endpoint.peers and endpoint.declare to a direct endpoint. Optional; absent means false." }
      }
    },
    "Grounds": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/GroundsCode" },
        "detail": { "$ref": "#/$defs/Detail" }
      }
    },
    "TurnReport": {
      "type": "object",
      "required": ["ref", "state"],
      "additionalProperties": false,
      "properties": {
        "ref": { "$ref": "#/$defs/TurnRef" },
        "state": { "$ref": "#/$defs/TurnState" }
      }
    },
    "PartRef": {
      "type": "object",
      "required": ["message_id", "part"],
      "additionalProperties": false,
      "properties": {
        "message_id": { "$ref": "#/$defs/MessageID" },
        "part": { "$ref": "#/$defs/PartNumber" }
      }
    },
    "PartAck": {
      "type": "object",
      "required": ["message_id", "part", "ack"],
      "additionalProperties": false,
      "properties": {
        "message_id": { "$ref": "#/$defs/MessageID" },
        "part": { "$ref": "#/$defs/PartNumber" },
        "ack": { "$ref": "#/$defs/ItemAck" }
      }
    },
    "PartNumber": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "RecvPage": {
      "description": "What one recv hands out, in the JSON shape the recv command prints. A message, or a part of one, has a body that is not empty. Go only: a part's label reads 'part index/total', index is not beyond total, next is present exactly on every part but the last, names this message and points at part index+1.",
      "type": "object",
      "required": ["lease", "messages", "more"],
      "additionalProperties": false,
      "properties": {
        "lease": { "$ref": "#/$defs/LeaseRef" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "body"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/MessageID" },
              "from": { "$ref": "#/$defs/Address" },
              "possibly_duplicate": { "type": "boolean" },
              "feedback": { "type": "boolean", "description": "The message is the node's own channel feedback; its sender is the system endpoint. Optional; absent means false." },
              "part": {
                "type": "object",
                "required": ["index", "total", "label"],
                "additionalProperties": false,
                "properties": {
                  "index": { "$ref": "#/$defs/PartNumber" },
                  "total": { "$ref": "#/$defs/PartNumber" },
                  "label": { "type": "string", "pattern": "^part [0-9]+/[0-9]+$" },
                  "next": {
                    "type": "object",
                    "required": ["msg", "part"],
                    "additionalProperties": false,
                    "properties": {
                      "msg": { "$ref": "#/$defs/MessageID" },
                      "part": { "$ref": "#/$defs/PartNumber" }
                    }
                  }
                }
              },
              "body": { "type": "string", "minLength": 1 }
            }
          }
        },
        "more": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "PresetConfig": {
      "type": "object",
      "required": ["name", "config"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/PresetName" },
        "config": { "$ref": "#/$defs/ConfigValues" }
      }
    },
    "ControlReply": {
      "description": "The reply to a control signal, with the signal named beside its fields. Go only: conditions are in ascending order; presets are sorted by name.",
      "oneOf": [
        {
          "title": "session.create",
          "type": "object",
          "required": ["signal", "outcome"],
          "additionalProperties": false,
          "properties": {
            "signal": { "const": "session.create" },
            "outcome": { "enum": ["created", "unconfirmed", "failed"] },
            "session_endpoint": { "$ref": "#/$defs/EndpointRef" },
            "reason": { "enum": ["preset_unknown", "preset_unavailable", "adapter_offline", "runtime_auth", "native_unavailable", "native_error", "ready_timeout", "adapter_lost", "control_unknown", "node_endpoint_limit", "model_choice_not_allowed"] }
          },
          "oneOf": [
            {
              "properties": { "outcome": { "const": "created" }, "reason": false },
              "required": ["session_endpoint"]
            },
            {
              "properties": { "outcome": { "const": "unconfirmed" }, "reason": { "enum": ["ready_timeout", "adapter_lost"] } },
              "required": ["session_endpoint", "reason"]
            },
            {
              "properties": {
                "outcome": { "const": "failed" },
                "session_endpoint": false,
                "reason": { "enum": ["preset_unknown", "preset_unavailable", "adapter_offline", "runtime_auth", "native_unavailable", "native_error", "control_unknown", "node_endpoint_limit", "model_choice_not_allowed"] }
              },
              "required": ["reason"]
            }
          ]
        },
        {
          "title": "session.close",
          "type": "object",
          "required": ["signal", "outcome"],
          "additionalProperties": false,
          "properties": {
            "signal": { "const": "session.close" },
            "outcome": { "enum": ["closed", "close_unconfirmed", "unsupported"] },
            "reason": { "enum": ["turn_still_running", "adapter_offline", "native_unreachable"] }
          },
          "oneOf": [
            { "properties": { "outcome": { "const": "close_unconfirmed" } }, "required": ["reason"] },
            { "properties": { "outcome": { "enum": ["closed", "unsupported"] }, "reason": false } }
          ]
        },
        {
          "title": "session.interrupt",
          "type": "object",
          "required": ["signal", "outcome"],
          "additionalProperties": false,
          "properties": {
            "signal": { "const": "session.interrupt" },
            "outcome": { "enum": ["stopped", "requested", "not_running", "failed", "unsupported"] },
            "reason": { "enum": ["adapter_offline", "native_unreachable", "native_error"] }
          },
          "oneOf": [
            { "properties": { "outcome": { "const": "failed" } }, "required": ["reason"] },
            { "properties": { "outcome": { "enum": ["stopped", "requested", "not_running", "unsupported"] }, "reason": false } }
          ]
        },
        {
          "title": "endpoint.status",
          "type": "object",
          "required": ["signal", "activity", "queued", "as_of"],
          "additionalProperties": false,
          "properties": {
            "signal": { "const": "endpoint.status" },
            "activity": { "enum": ["idle", "busy", "unknown"] },
            "queued": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "conditions": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "enum": ["adapter_offline", "runtime_auth", "native_unavailable", "server_request_rejected", "control_unknown", "version_untested"],
                "description": "version_untested is obsolete: a reply stored before it was removed may carry it, and nothing produces it."
              }
            },
            "presets": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "available"],
                "additionalProperties": false,
                "properties": {
                  "name": { "$ref": "#/$defs/PresetName" },
                  "available": { "type": "boolean" },
                  "model": { "$ref": "#/$defs/ModelName" },
                  "effort": { "$ref": "#/$defs/Effort" },
                  "allowed_models": { "$ref": "#/$defs/AllowedModels" }
                }
              }
            },
            "as_of": { "description": "Unix seconds, up to 9999-12-31T23:59:59Z.", "type": "integer", "minimum": 1, "maximum": 253402300799 }
          }
        }
      ]
    }
  }
}
